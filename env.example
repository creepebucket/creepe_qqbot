# MCSM 面板配置
# MCSM面板访问地址
MCSM_URL=http://localhost:23333

# MCSM API密钥（必填）
MCSM_APIKEY=your_api_key_here

# MCSM守护进程ID（必填）
MCSM_DAEMON_ID=your_daemon_id_here

# 服务器实例ID配置
# 各个服务器的实例UUID，不需要的可以留空或删除
MCSM_SLIMEFUN_ID=f645c80e421f4fea8997ba6eb53644b7
MCSM_SURVIVAL_ID=
MCSM_CREATIVE_ID=
MCSM_SKYBLOCK_ID=
MCSM_MAIN_ID=
MCSM_TEST_ID=

# 其他配置（如果需要）
# 数据库连接等敏感信息也可以放这里
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=aibot
# DB_USER=
# DB_PASSWORD= 