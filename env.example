# MCSM 面板配置
# MCSM面板访问地址
MCSM_URL=http://localhost:23333

# MCSM API密钥（必填）
MCSM_APIKEY=your_api_key_here

# MCSM守护进程ID（必填）
MCSM_DAEMON_ID=your_daemon_id_here

# 服务器实例ID配置
# 在这里配置你的服务器实例，格式为 "服务器1,服务器2,服务器3"
# 这里的名称将作为指令中的 server_name 参数
INSTANCES=slimefun,survival,creative,skyblock,main,test

# 各个服务器的实例UUID，不需要的可以留空或删除
# 变量名格式必须为 MCSM_{实例名大写}_ID
MCSM_SLIMEFUN_ID=f645c80e421f4fea8997ba6eb53644b7
MCSM_SURVIVAL_ID=
MCSM_CREATIVE_ID=
MCSM_SKYBLOCK_ID=
MCSM_MAIN_ID=
MCSM_TEST_ID=

# Git 备份配置
# 是否启用Git备份
GIT_BACKUP_ENABLED=false

# Git备份最大保留数量
GIT_BACKUP_MAX_COUNT=10

# Git提交时使用的用户名
GIT_BACKUP_USER_NAME=MCSM Bot

# Git提交时使用的邮箱
GIT_BACKUP_USER_EMAIL=bot@mcsm.local

# Git备份路径配置，留空则使用动态路径
# 如果配置了此项，将优先使用这里的路径
# 格式为 "服务器1:/path/to/backup1,服务器2:/path/to/backup2"
GIT_BACKUP_PATHS=

# MCSM 实例数据存储基础路径
# 用于动态生成服务器备份路径
MCSM_BASE_PATH=/opt/mcsmanager/daemon/data/InstanceData

# 备份目标
# 'full' - 备份整个服务器目录
# 'world' - 只备份存档目录
MCSM_BACKUP_TARGET=full

# 其他配置（如果需要）
# 数据库连接等敏感信息也可以放这里
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=aibot
# DB_USER=
# DB_PASSWORD= 